<Window x:Class="mvp_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Personalanforderung" MinWidth="980" MinHeight="620" Width="1250" Height="760"
        Background="#F3F5F7" FontFamily="Segoe UI" Foreground="#1E2933">
    <Window.Resources>
        <x:Array x:Key="StatusOptions" Type="sys:String">
            <sys:String>(leer)</sys:String><sys:String>PAL</sys:String><sys:String>BÖRSE/WOPO</sys:String>
            <sys:String>BÖRSE</sys:String><sys:String>Palettieren</sys:String><sys:String>TAZ</sys:String>
            <sys:String>Blätchen</sys:String><sys:String>DIP</sys:String><sys:String>KICKER</sys:String>
            <sys:String>WZ</sys:String><sys:String>GAZ</sys:String><sys:String>SONSTIGES</sys:String>
        </x:Array>
        <x:Array x:Key="NameOptions" Type="sys:String">
            <sys:String>FARA</sys:String><sys:String>MHL</sys:String><sys:String>Person</sys:String><sys:String>Sonst.</sys:String>
        </x:Array>
        <x:Array x:Key="TimeOptions" Type="sys:String">
            <sys:String>00:00</sys:String><sys:String>01:00</sys:String><sys:String>02:00</sys:String><sys:String>03:00</sys:String>
            <sys:String>04:00</sys:String><sys:String>05:00</sys:String><sys:String>06:00</sys:String><sys:String>07:00</sys:String>
            <sys:String>08:00</sys:String><sys:String>09:00</sys:String><sys:String>10:00</sys:String><sys:String>11:00</sys:String>
            <sys:String>12:00</sys:String><sys:String>13:00</sys:String><sys:String>14:00</sys:String><sys:String>15:00</sys:String>
            <sys:String>16:00</sys:String><sys:String>17:00</sys:String><sys:String>18:00</sys:String><sys:String>19:00</sys:String>
            <sys:String>20:00</sys:String><sys:String>21:00</sys:String><sys:String>22:00</sys:String><sys:String>23:00</sys:String>
        </x:Array>
        <x:Array x:Key="EndOptions" Type="sys:String">
            <sys:String>(leer)</sys:String><sys:String>ca. 00:00</sys:String><sys:String>ca. 01:00</sys:String><sys:String>ca. 02:00</sys:String>
            <sys:String>ca. 03:00</sys:String><sys:String>ca. 04:00</sys:String><sys:String>ca. 05:00</sys:String><sys:String>ca. 06:00</sys:String>
            <sys:String>ca. 07:00</sys:String><sys:String>ca. 08:00</sys:String><sys:String>ca. 09:00</sys:String><sys:String>ca. 10:00</sys:String>
            <sys:String>ca. 11:00</sys:String><sys:String>ca. 12:00</sys:String><sys:String>ca. 13:00</sys:String><sys:String>ca. 14:00</sys:String>
            <sys:String>ca. 15:00</sys:String><sys:String>ca. 16:00</sys:String><sys:String>ca. 17:00</sys:String><sys:String>ca. 18:00</sys:String>
            <sys:String>ca. 19:00</sys:String><sys:String>ca. 20:00</sys:String><sys:String>ca. 21:00</sys:String><sys:String>ca. 22:00</sys:String>
            <sys:String>ca. 23:00</sys:String><sys:String>END</sys:String><sys:String>ENDE</sys:String><sys:String>PAL</sys:String><sys:String>BÖRSE/WOPO</sys:String>
            <sys:String>BÖRSE</sys:String><sys:String>TAZ</sys:String><sys:String>Blätchen</sys:String><sys:String>KICKER</sys:String>
            <sys:String>WZ</sys:String><sys:String>GAZ</sys:String><sys:String>SONSTIGES</sys:String>
        </x:Array>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="#C8D1D9" />
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#1E2933" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,4" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C8D1D9" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,2" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C8D1D9" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#274C5E" /><Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="9,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="BorderBrush" Value="#527487" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,3" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D8E0E6" /><Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="34" /><Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E0E6" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RowPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="RowPreviewMouseMove" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CDE8F2" /><Setter Property="Foreground" Value="#123544" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D8E0E6" BorderThickness="0,0,0,1" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Personalanforderung" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Produktionsplan schnell wie in einer Tabelle erstellen" Foreground="#657784" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Produktionsbeginn" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding ProductionDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="145" />
                    <TextBlock Text="{Binding GermanDate}" FontWeight="SemiBold" Foreground="#176B87" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D8E0E6" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Message}" Foreground="#176B87" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ausgewählt: " VerticalAlignment="Center" /><TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <TextBlock Text="Belegt: " VerticalAlignment="Center" /><TextBlock Text="{Binding TotalPersonnel}" FontWeight="Bold" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <Button Content="Excel erstellen" Click="GenerateClick" Background="#D66B2D" Foreground="White" BorderBrush="#D66B2D" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="#E8F1F4" BorderBrush="#C8D9E0" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="145" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Mehrere Zeilen bearbeiten" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                <ComboBox Grid.Column="1" ItemsSource="{StaticResource TimeOptions}" Text="{Binding BulkStartTime, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" ToolTip="Von" Margin="0,0,8,0" />
                <ComboBox Grid.Column="2" ItemsSource="{StaticResource EndOptions}" Text="{Binding BulkEndTime, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" ToolTip="Bis" Margin="0,0,8,0" />
                <ComboBox Grid.Column="3" ItemsSource="{StaticResource StatusOptions}" SelectedItem="{Binding BulkStatus, Mode=TwoWay}" IsEditable="True" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Anwenden" Click="ApplyBulkClick" Background="#176B87" Foreground="White" BorderBrush="#176B87" />
                <TextBlock Grid.Column="5" Text="Von / Bis: 09:00, ca. 16:00, ENDE oder WZ" Foreground="#657784" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <ToolBarTray DockPanel.Dock="Top" Background="#F3F5F7"><ToolBar Background="Transparent" BorderThickness="0" Padding="10,7">
            <Button Content="Neue Zeile" Click="AddRowClick" /><Button Content="Leere Zeile einfügen" Click="InsertBlankClick" /><Separator />
            <Button Content="Zeile duplizieren" Click="DuplicateClick" /><Button Content="Zeile leeren" Click="ClearClick" />
            <Button Content="Zeile löschen" Click="DeleteClick" Foreground="#A43B3B" /><Button Content="Spalte leeren" Click="ClearColumnClick" Foreground="#A43B3B" /><Separator />
            <TextBlock Text="Zeilen markieren und Von / Bis direkt ändern" Foreground="#657784" VerticalAlignment="Center" Margin="8,0,0,0" />
        </ToolBar></ToolBarTray>
        <DataGrid x:Name="GroupsGrid" ItemsSource="{Binding Groups}" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="All" GridLinesVisibility="All"
                  RowHeaderWidth="42" RowHeight="34" Background="White" BorderBrush="#C8D1D9"
                  SelectionChanged="GroupsSelectionChanged" PreviewKeyDown="GroupsGridPreviewKeyDown" CellEditEnding="GridCellEditEnding" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Datum Produktionsbeginn" Width="1.7*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding DataContext.GermanDate, RelativeSource={RelativeSource AncestorType=DataGrid}}" /><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Text" Value="" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
                </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Name" Width="1.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{StaticResource NameOptions}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Vorname" Binding="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                <DataGridTemplateColumn Header="Von" Width="0.8*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{StaticResource TimeOptions}" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Bis" Width="1.0*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{StaticResource EndOptions}" Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="1.3*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <ComboBox ItemsSource="{StaticResource StatusOptions}" SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="StatusSelectionChanged" IsEditable="True" />
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
